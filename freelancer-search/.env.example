# Required. There is no fallback: without these the app shows a setup screen.

# The agent (any model Pi supports; defaults to Azure OpenAI gpt-5.5)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com
# LLM_PROVIDER=azure-openai-responses   # or: anthropic (then set ANTHROPIC_API_KEY)
# LLM_MODEL=gpt-5.5                     # Azure deployment name, or e.g. claude-opus-5-5
# AGENT_THINKING=medium                 # low | medium | high

# Jev (TypeSafe), screens every candidate: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional
# GITHUB_API_TOKEN=     # raises GitHub's limit for the agent's GitHub lookups (60/hour without)
# PORT=8787
